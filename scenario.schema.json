{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "virtmcu-scenario",
  "description": "Schema for virtmcu-scenario.toml multi-node simulation scenario files",
  "type": "object",
  "required": ["schema_version", "scenario", "nodes", "steps"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Scenario schema version (must be 1)"
    },
    "scenario": {
      "type": "object",
      "required": ["name", "world", "timeout_vtime_ms"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier for the scenario"
        },
        "world": {
          "type": "string",
          "minLength": 1,
          "description": "Registered catalog world name (e.g. nrf52840_ot)"
        },
        "timeout_vtime_ms": {
          "type": "integer",
          "minimum": 1,
          "description": "Virtual time timeout in milliseconds"
        },
        "pass_regex": {
          "type": "string",
          "description": "Optional regular expression for passing output"
        },
        "fail_regex": {
          "type": "string",
          "description": "Optional regular expression for failing output"
        }
      }
    },
    "nodes": {
      "type": "object",
      "description": "Mapping of node ID (as string) to firmware artifact or path",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "description": "Ordered sequence of per-node console input steps",
      "items": {
        "type": "object",
        "required": ["node", "delivery_vtime_ms", "data"],
        "additionalProperties": false,
        "properties": {
          "node": {
            "type": "integer",
            "minimum": 0,
            "description": "Target node index (must be present in nodes)"
          },
          "delivery_vtime_ms": {
            "type": "integer",
            "minimum": 0,
            "description": "Virtual time timestamp in milliseconds when data is injected"
          },
          "data": {
            "type": "string",
            "description": "CLI data string to inject into guest console"
          }
        }
      }
    }
  }
}
